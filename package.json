{
  "name": "smart-carpark-api",
  "version": "1.0.0",
  "description": "Backend API for Smart Carpark admin system",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pretest": "node -e \"require('fs').rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p test/tsconfig.json",
    "test": "node --env-file=test/support/test.env --test --test-timeout=30000 \".test-dist/test/services/*.test.js\" \".test-dist/test/unit/**/*.test.js\"",
    "prisma:generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:admin": "tsx prisma/seed/admin.ts",
    "db:seed:transactions": "tsx prisma/seed/transactions.ts",
    "db:studio": "prisma studio",
    "docker:db": "docker compose up -d db"
  },
  "keywords": [
    "nodejs",
    "express",
    "api",
    "smart-carpark"
  ],
  "author": "OpenAI",
  "license": "MIT",
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "deepmerge-ts": "^8.0.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "multer": "^2.5.0",
    "omise": "^1.1.0",
    "p-timeout": "^8.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "proxy-addr": "^2.0.8",
    "rate-limiter-flexible": "^11.2.3",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  }
}

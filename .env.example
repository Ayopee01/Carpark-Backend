# Server
PORT=8080
TRUST_PROXY=1

# CORS (Example)
# Admin Frontend ที่เรียก API ด้วย session cookie (origin ตรงตัว คั่นด้วย , ห้ามใช้ *)
ADMIN_ORIGINS=http://localhost:3000
# Kiosk/Barrier Gate/Mobile ที่เรียก /api/client จาก browser (ไม่ใช้ cookie)
CLIENT_ORIGINS=http://localhost:3001

# Auth cookie: true = ไม่ใส่ Secure (dev ใช้ false)
AUTH_COOKIE_INSECURE=false

# AllowedIps: true = ตู้ kiosk/barrier gate ทุกตู้ต้องตั้ง allowedIps ก่อนใช้งาน (dev ใช้ false)
REQUIRE_DEVICE_ALLOWED_IPS=false

# Auth (Example)
AUTH_TOKEN_SECRET=f7fb4444e7be3f5954d983a4f05890c065f16a641c4fd7cf47c4e76e89af9cba

# Ping SSE & WebSocket
REALTIME_PING_INTERVAL_MS=25000

# Rate limit
LOGIN_RATE_LIMIT=10
ACTIVATION_RATE_LIMIT=20
PUBLIC_CLIENT_RATE_LIMIT=120
DEVICE_AUTH_RATE_LIMIT=30

# Uploads
UPLOADS_HOST_PATH=/srv/smart-carpark/uploads

# Config Database (Example)
POSTGRES_DB=smart_carpark
POSTGRES_USER=smart_carpark
POSTGRES_PASSWORD=devpassword123
DATABASE_URL=postgresql://smart_carpark:devpassword123@localhost:5433/smart_carpark?schema=public

# Omise Payment Gateway
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=
OMISE_CURRENCY=thb
OMISE_QR_EXPIRY_MINUTES=10

# Mode Test Payment Simulation
ENABLE_PAYMENT_SIMULATION=false
PAYMENT_SIMULATION_TOKEN=

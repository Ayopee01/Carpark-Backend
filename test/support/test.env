# Env ของ npm test (ค่าที่ API บังคับตั้งใน .env) ใช้กับ node --env-file
PORT=8080
TRUST_PROXY=1
CLIENT_ORIGINS=http://localhost:3001
ADMIN_ORIGINS=http://localhost:3000
AUTH_TOKEN_SECRET=test-token-secret
REALTIME_PING_INTERVAL_MS=25000
LOGIN_RATE_LIMIT=10
ACTIVATION_RATE_LIMIT=20
PUBLIC_CLIENT_RATE_LIMIT=120
OMISE_CURRENCY=thb
OMISE_QR_EXPIRY_MINUTES=10

          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.configUpdatedAt) pm.collectionVariables.set('pricingConfigUpdatedAt', json.configUpdatedAt);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Pricing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pricing",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"configUpdatedAt\": \"{{pricingConfigUpdatedAt}}\",\n  \"pricingRules\": [\n    {\n      \"name\": \"Car first 3 hours\",\n      \"feeType\": \"base_hour\",\n      \"vehicleType\": \"car\",\n      \"hourEnd\": 3,\n      \"price\": 30,\n      \"status\": \"active\"\n    },\n    {\n      \"name\": \"Car next hours\",\n      \"feeType\": \"next_hour\",\n      \"vehicleType\": \"car\",\n      \"hourStart\": 4,\n      \"hourEnd\": 24,\n      \"price\": 20,\n      \"status\": \"active\"\n    },\n    {\n      \"name\": \"Car overnight\",\n      \"feeType\": \"overnight_day\",\n      \"vehicleType\": \"car\",\n      \"price\": 100,\n      \"status\": \"active\"\n    }\n  ]\n}"
            },
            "description": "Only write endpoint for pricing: send the whole pricingRules array (add = no id, edit = keep id, delete = leave out). Send configUpdatedAt from GET /config; an old value returns 409 PRICING_CONFIG_CONFLICT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.configUpdatedAt) pm.collectionVariables.set('pricingConfigUpdatedAt', json.configUpdatedAt);"
                ]
              }
            }
          ]
        }
      ]

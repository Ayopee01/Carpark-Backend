          }
        },
        {
          "name": "Search Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/transactions?keyword=PK&page=1&per_page=10"
          }
        },
        {
          "name": "Search Transactions All By Plate",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/transactions?keyword=กข1234&all=true"
          }
        },
        {
          "name": "Transaction Events SSE",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/transactions/events?page=1&per_page=10"
          }
        },
        {
          "name": "Create Transaction From Camera",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateNo\": \"1กก1234\",\n  \"vehicleType\": \"car\",\n  \"cameraId\": \"CAM-IN-01\",\n  \"direction\": \"IN\",\n  \"capturedAt\": \"2026-05-22T10:30:00+07:00\",\n  \"confidence\": 0.92,\n  \"imageUrl\": \"https://example.com/plate.jpg\"\n}"
            }
          }
        },
        {
          "name": "Get Transaction By Plate",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/transactions/{{transactionPlateNo}}"
          }
        },
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transactions/{{transactionPlateNo}}/payment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"cash\",\n  \"channel\": \"cashier\",\n  \"amount\": 40\n}"
            }
          }
        },
        {
          "name": "Process EDC Card Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transactions/{{transactionPlateNo}}/payment",
            "description": "Card taken on the counter EDC terminal. reference and edcDeviceId (from Admin EDC Terminals) are required for method card.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"card\",\n  \"channel\": \"cashier\",\n  \"reference\": \"APPR-123456\",\n  \"edcDeviceId\": \"{{cashierEdcDeviceId}}\"\n}"
            }
          }
        },
        {
          "name": "Patch Transaction",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transactions/{{transactionPlateNo}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateNo\": \"8ขช1001\",\n  \"vehicleType\": \"car\"\n}"
            }
          }
        },
        {
          "name": "Change Transaction Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transactions/{{transactionPlateNo}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelled\"\n}"
            },
            "description": "Status is changed through PATCH /transactions/:plateNo (the /status route was removed)."
          }
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/transactions/{{transactionPlateNo}}"
          }
        }
      ]
    },
